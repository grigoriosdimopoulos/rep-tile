<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="gymtracker.db" />
        <include domain="sharedpref" path="user_prefs.preferences_pb" />
        <exclude domain="database" path="gymtracker.db-shm" />
        <exclude domain="database" path="gymtracker.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gymtracker.db" />
        <include domain="sharedpref" path="user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
